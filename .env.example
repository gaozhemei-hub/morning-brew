# ── 五道口 AI 早咖啡 · 配置示例 ─────────────────────────────
# 复制成 .env 后改成你自己的值：  cp .env.example .env
# ⚠️ .env 已在 .gitignore 里，不要把真实凭据提交进仓库。

# 邮件投递（provider=none 时只输出到本地文件，不发信，也不报错）
MORNING_BREW_EMAIL_PROVIDER=none          # none | qq | gmail | smtp
MORNING_BREW_EMAIL_TO=you@example.com     # ← 换成你的收件邮箱
MORNING_BREW_EMAIL_FROM=you@example.com   # ← 换成你的发件邮箱
# QQ 邮箱：设置→账户→开启 POP3/SMTP 服务→生成【授权码】
# Gmail ：需两步验证 → 生成"应用专用密码"
MORNING_BREW_SMTP_HOST=smtp.qq.com
MORNING_BREW_SMTP_PORT=465
MORNING_BREW_SMTP_USER=you@example.com
MORNING_BREW_SMTP_PASS=                   # 授权码，不是登录密码

# 代理（可选）：访问海外信源需要时填，例如 http://127.0.0.1:7890
# MORNING_BREW_PROXY=

# 每日运行时间（可选）：仅用于 install_schedule.py，例如 08:40
# MORNING_BREW_AT=07:30

# 输出目录（可选）：早咖啡/知识库 markdown 落在哪
# MORNING_BREW_VAULT=~/morning-brew-output

# ── 语音晨报（可选）：scripts/voice_brief.py ─────────────────
# 不填 Key 也能跑：文字版照常发，邮件里会写明"语音未生成"的原因
# 阶跃开放平台 platform.stepfun.com → 创建 API Key（用普通 Key）
MORNING_BREW_STEPFUN_API_KEY=
MORNING_BREW_TTS_MODEL=stepaudio-2.5-tts
MORNING_BREW_TTS_VOICE=cixingnansheng     # 先跑 voice_brief.py --list-voices，换成你喜欢的音色 ID
# MORNING_BREW_TTS_INSTRUCTION=晨间新闻播报，语气清晰沉稳、节奏明快，关键数字和结论稍作强调
MORNING_BREW_LLM_MODEL=step-3.5-flash     # 把阅读稿改写成收听稿用的对话模型
MORNING_BREW_VOICE_MINUTES=10             # 目标时长（分钟），按约 270 字/分钟做取舍
